# Runtime artefacts written outside the repo but listed here for awareness:
#   ~/.local/share/mcp-screen/world/map.db      world-model SQLite cache
#   ~/.local/share/mcp-screen/sessions/*/       recorder trajectories + frames
#   ~/.local/state/mcp-screen/actions.jsonl     reliability audit log
#   ~/.config/mcp-screen/token                  portal restore token
#   /tmp/screen_err.txt                         last unhandled tool traceback
.deps/
.provisioned-*

# vmbed VM overlays live in ~/.cache, never in-tree
tests/vmbed/*.qcow2
